{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr review *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue view *)",
      "Bash(gh run view *)",
      "Bash(ls *)",
      "Bash(pwd)"
    ],
    "deny": [
      "Read(.env*)",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow *)",
      "Bash(gh secret *)",
      "Bash(gh api *)",
      "Bash(sudo *)"
    ]
  }
}
