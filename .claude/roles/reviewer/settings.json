{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillOverrides": {
    "tworca-wymagan": "off",
    "iskt-softwarehouse-tworca-wymagan": "off",
    "iskt-planista-realizacji": "off"
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr review *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue view *)",
      "Bash(gh run view *)",
      "Bash(ls *)",
      "Bash(pwd)"
    ],
    "deny": [
      "Skill(tworca-wymagan)",
      "Skill(iskt-softwarehouse-tworca-wymagan)",
      "Skill(iskt-planista-realizacji)",
      "Read(.env*)",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash(git push *)",
      "Bash(git push * production)",
      "Bash(git commit *)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow *)",
      "Bash(gh secret *)",
      "Bash(gh api *)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/Shared/sh/bin/odczyt-hook.sh || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
